                                               },
                                      "intenseTextStyle":  "bright",
                                      "opacity":  72,
                                      "padding":  "14, 10, 14, 10",
                                      "scrollbarState":  "hidden",
                                      "useAcrylic":  true
                                  },
                     "list":  [
                                  {
