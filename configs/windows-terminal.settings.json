                        },
                        {
                            "id":  "Terminal.PasteFromClipboard",
                            "keys":  "ctrl+v"
                        },
                        {
                            "id":  "Terminal.DuplicatePaneAuto",
                            "keys":  "alt+shift+d"
                        },
                        {
                            "id":  "User.quakeMode",
                            "keys":  "win+sc(41)"
                        }
                    ],
    "launchMode":  "default",
    "newTabMenu":  [
