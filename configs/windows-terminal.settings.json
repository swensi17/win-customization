                        "brightBlack":  "#414868",
                        "brightBlue":  "#7AA2F7",
                        "brightCyan":  "#A4DAFF",
                        "brightGreen":  "#B9F27C",
                        "brightPurple":  "#C0A8FF",
                        "brightRed":  "#FF7A93",
                        "brightWhite":  "#FFFFFF",
                        "brightYellow":  "#FF9E64",
                        "cursorColor":  "#1793D1",
